rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, create, update, delete: if owner(uid) || admin();
      match /fcmTokens/{token} { allow read, write: if owner(uid) || admin(); }
      match /notifications/{notificationId} { allow read, update: if owner(uid) || admin(); allow create: if false; }
    }
    match /items/{itemId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid; allow update, delete: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid); }
    match /claims/{claimId} { allow read: if signedIn() && (resource.data.donorId == request.auth.uid || resource.data.claimantId == request.auth.uid || admin()); allow create: if signedIn() && request.resource.data.claimantId == request.auth.uid; allow update: if admin() || (signedIn() && (resource.data.donorId == request.auth.uid || resource.data.claimantId == request.auth.uid)); }
    match /requests/{requestId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid; allow update, delete: if admin() || (signedIn() && resource.data.requesterId == request.auth.uid); }
    match /verifications/{verificationId} { allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update: if admin(); }
    match /impactMetrics/{uid} { allow read: if owner(uid) || admin(); allow write: if false; }
    match /analytics/{document=**} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}